# Copy to .env and fill in. Never commit .env.

# --- Neo4j AuraDB (console.neo4j.io → your instance → connection details) ---
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=<instance-id>
NEO4J_PASSWORD=change-me

# --- LLM provider ---
# bedrock | groq. Defaults to bedrock when BEDROCK_API_KEY is set, else groq.
# LLM_PROVIDER=bedrock

# Amazon Bedrock (OpenAI-compatible endpoint, paid from AWS credits)
# BEDROCK_API_KEY=
# BEDROCK_REGION=us-west-2
# BEDROCK_MODEL=openai.gpt-oss-120b-1:0
# runtime (default) | mantle. mantle serves more open-weight models under
# unversioned ids, e.g. BEDROCK_MODEL=qwen.qwen3-coder-480b-a35b-instruct
# BEDROCK_ENDPOINT=runtime

# Groq (free tier, ~8,000 tokens/min per key). Comma-separated, one key per account.
GROQ_API_KEYS=
# GROQ_MODEL=openai/gpt-oss-120b

# --- Code review → GitHub issues ---
# Fine-grained token limited to the repositories you choose: Issues read/write (+ Metadata read).
# RepoMind only files issues on repositories this token can push to or triage.
# GITHUB_TOKEN=
# REVIEW_DEFAULT_COMMITS=5
# REVIEW_MAX_FILES=12
# REVIEW_MAX_BATCHES=8
# REVIEW_MAX_ISSUES=10
# REVIEW_MIN_SEVERITY=medium
# REVIEW_CLOSE_RESOLVED=1
# LLM_PROVIDER_REVIEW=groq

# --- Pull request text as decision-record evidence ---
# The decision records read the GitHub pull requests and issues their evidence commits belong to.
# Without GITHUB_TOKEN at most 12 are fetched per analysis (GitHub allows 60 requests/hour);
# with it, ADR_PR_MAX_FETCH. Fetched text is cached in the cache folder for 30 days.
# ADR_PR_LOOKUP=1             # 0 turns it off
# ADR_PR_MAX_FETCH=60

# --- Large or unsupported repositories ---
# GITHUB_TOKEN above also lifts the pre-clone GitHub check from 60 to 5,000 requests/hour
# (any token works for public repositories). Without it, that check may be skipped.
# CLONE_TIMEOUT_SECONDS=600
# CLONE_DEPTH=1501            # commits fetched (HISTORY_MAX_COMMITS + 1); 0 = full history
# LARGE_REPO_FILES=3000       # above this many source files, large-repo mode
# MAX_SOURCE_FILES=3000       # files analyzed in large-repo mode
# LARGE_REPO_SNAPSHOTS=6      # history snapshots in large-repo mode
